generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model users {
  id            BigInt        @id @default(autoincrement())
  username      String        @unique @db.VarChar(100)
  password_hash String        @db.VarChar(255)
  role          String        @default("USER") @db.VarChar(20)
  is_active     Boolean       @default(true)
  last_login_at DateTime?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  audit_logs    audit_logs[]
  export_logs   export_logs[]

  @@index([role])
  @@index([is_active])
}

model pics {
  id                  BigInt                @id @default(autoincrement())
  name                String                @unique @db.VarChar(100)
  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now())
  daily_activity_pics daily_activity_pics[]
}

model categories {
  id               BigInt             @id @default(autoincrement())
  name             String             @unique @db.VarChar(50)
  daily_activities daily_activities[]
  sub_categories   sub_categories[]
}

model sub_categories {
  id               BigInt             @id @default(autoincrement())
  category_id      BigInt
  name             String             @db.VarChar(100)
  daily_activities daily_activities[]
  category         categories         @relation(fields: [category_id], references: [id])

  @@unique([category_id, name])
}

model daily_activities {
  id                  BigInt                @id @default(autoincrement())
  activity_date       DateTime              @db.Date
  activity            String                @db.VarChar(255)
  institution_group   String?               @db.VarChar(255)
  address             String?               @db.VarChar(255)
  focus               String?               @db.VarChar(255)
  location            String?               @db.VarChar(255)
  description_result  String?               @db.Text
  keterangan          String?               @db.Text
  hasil               String?               @db.Text
  kesimpulan          String?               @db.Text
  next_plan           String?               @db.Text
  category_id         BigInt
  sub_category_id     BigInt
  is_deleted          Boolean               @default(false)
  is_archived         Boolean               @default(false)
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt
  cost                Decimal?              @db.Decimal(15, 2)
  sharepoint_links    Json?
  category            categories            @relation(fields: [category_id], references: [id])
  sub_category        sub_categories        @relation(fields: [sub_category_id], references: [id])
  daily_activity_pics daily_activity_pics[]
  photos              daily_activity_photos[]

  @@index([activity_date])
  @@index([is_deleted])
  @@index([is_archived])
  @@index([category_id], map: "daily_activities_category_id_fkey")
  @@index([sub_category_id], map: "daily_activities_sub_category_id_fkey")
}

model daily_activity_pics {
  activity_id    BigInt
  pic_id         BigInt
  daily_activity daily_activities @relation(fields: [activity_id], references: [id], onDelete: Cascade)
  pic            pics             @relation(fields: [pic_id], references: [id])

  @@id([activity_id, pic_id])
  @@index([pic_id])
}

model daily_activity_photos {
  id            BigInt           @id @default(autoincrement())
  activity_id   BigInt
  photo_data    Bytes            @db.MediumBlob
  mime_type     String           @db.VarChar(100)
  original_name String           @db.VarChar(255)
  size_bytes    Int
  sha256        String           @db.Char(64)
  sort_order    Int              @default(0)
  is_deleted    Boolean          @default(false)
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt
  activity      daily_activities @relation(fields: [activity_id], references: [id], onDelete: Cascade)

  @@index([activity_id, sort_order])
  @@index([is_deleted])
  @@unique([activity_id, sha256], map: "daily_activity_photos_activity_sha256_key")
}

model stakeholder_engagement {
  id               BigInt    @id @default(autoincrement())
  stakeholder      String?   @db.VarChar(255)
  date             DateTime? @db.Date
  venue            String?   @db.VarChar(255)
  concern_issue    String?   @db.Text
  sharepoint_links Json?
  is_deleted       Boolean   @default(false)
  is_archived      Boolean   @default(false)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@index([is_deleted])
  @@index([is_archived])
}

model top_issues {
  id               BigInt   @id @default(autoincrement())
  period           String   @db.VarChar(50)
  year             Int      @default(2026)
  issue            String   @db.VarChar(255)
  description      String?  @db.Text
  follow_up        String?  @db.Text
  next_plan        String?  @db.Text
  sharepoint_links Json?
  is_deleted       Boolean  @default(false)
  is_archived      Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([is_deleted])
  @@index([is_archived])
  @@index([year])
}

model proposals {
  id                   BigInt   @id @default(autoincrement())
  registration_no      String   @unique @db.VarChar(50)
  date_received        DateTime @db.Date
  institution          String   @db.VarChar(255)
  address              String?  @db.VarChar(255)
  proposal_description String?  @db.Text
  status               String   @db.VarChar(20)
  sharepoint_links     Json?
  is_deleted           Boolean  @default(false)
  is_archived          Boolean  @default(false)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@index([status])
  @@index([is_deleted])
  @@index([is_archived])
}

model csr_projects {
  id                    BigInt   @id @default(autoincrement())
  project_year          Int      @db.Year
  program               String   @db.VarChar(255)
  activity              String?  @db.VarChar(255)
  type_of_activity      String?  @db.VarChar(100)
  location              String?  @db.VarChar(255)
  target_beneficiaries  String?  @db.VarChar(255)
  objective             String?  @db.Text
  status                String   @default("Planning") @db.VarChar(20)
  budget                Decimal? @db.Decimal(15, 2)
  implementation_period String?  @db.VarChar(100)
  sharepoint_links      Json?
  is_deleted            Boolean  @default(false)
  is_archived           Boolean  @default(false)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@index([project_year])
  @@index([status])
  @@index([is_deleted])
  @@index([is_archived])
}

model grievance {
  id               BigInt             @id @default(autoincrement())
  register_no      String             @unique @db.VarChar(50)
  log_date         DateTime           @db.Date
  complainant_name String             @db.VarChar(255)
  address          String?            @db.VarChar(255)
  phone            String?            @db.VarChar(30)
  category         String?            @db.VarChar(100)
  significance     String             @db.VarChar(20)
  description      String?            @db.Text
  location         String?            @db.VarChar(255)
  investigation    String?            @db.Text
  resolution       String?            @db.Text
  feedback         String?            @db.Text
  status           String             @default("Open") @db.VarChar(20)
  completion_date  DateTime?          @db.Date
  remarks          String?            @db.Text
  sharepoint_links Json?
  is_deleted       Boolean            @default(false)
  is_archived      Boolean            @default(false)
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  photos           grievance_photos[]

  @@index([status])
  @@index([significance])
  @@index([is_deleted])
  @@index([is_archived])
}

model grievance_photos {
  id            BigInt    @id @default(autoincrement())
  grievance_id  BigInt
  photo_data    Bytes     @db.MediumBlob
  mime_type     String    @db.VarChar(100)
  original_name String    @db.VarChar(255)
  size_bytes    Int
  sha256        String    @db.Char(64)
  sort_order    Int       @default(0)
  is_deleted    Boolean   @default(false)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  grievance     grievance @relation(fields: [grievance_id], references: [id], onDelete: Cascade)

  @@unique([grievance_id, sha256], map: "grievance_photos_grievance_sha256_key")
  @@index([grievance_id, sort_order])
  @@index([is_deleted])
}

model lrp {
  id               BigInt   @id @default(autoincrement())
  program          String   @db.VarChar(255)
  year             Int      @default(2026)
  sharepoint_links Json?
  is_deleted       Boolean  @default(false)
  is_archived      Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([is_deleted])
  @@index([is_archived])
  @@index([year])
}

model export_logs {
  id            BigInt    @id @default(autoincrement())
  exported_at   DateTime  @default(now())
  scope_year    Int?
  format        String    @db.VarChar(10)
  status        String    @db.VarChar(20)
  error_message String?   @db.Text
  actor_user_id BigInt?
  actor         users?    @relation(fields: [actor_user_id], references: [id], onDelete: SetNull)

  @@index([exported_at])
  @@index([status])
  @@index([actor_user_id])
}

model audit_logs {
  id            BigInt   @id @default(autoincrement())
  entity_type   String   @db.VarChar(50)
  entity_id     BigInt
  action        String   @db.VarChar(20)
  changes       Json?
  actor_user_id BigInt?
  actor         users?   @relation(fields: [actor_user_id], references: [id], onDelete: SetNull)
  created_at    DateTime @default(now())

  @@index([entity_type, entity_id])
  @@index([created_at])
  @@index([actor_user_id])
}
