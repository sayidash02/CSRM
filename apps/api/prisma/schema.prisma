generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model pics {
  id               BigInt             @id @default(autoincrement())
  name             String             @unique @db.VarChar(100)
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now())
  daily_activities daily_activities[]
}

model categories {
  id               BigInt             @id @default(autoincrement())
  name             String             @unique @db.VarChar(50)
  daily_activities daily_activities[]
  sub_categories   sub_categories[]
}

model sub_categories {
  id               BigInt             @id @default(autoincrement())
  category_id      BigInt
  name             String             @db.VarChar(100)
  daily_activities daily_activities[]
  category         categories         @relation(fields: [category_id], references: [id])

  @@unique([category_id, name])
}

model daily_activities {
  id                 BigInt         @id @default(autoincrement())
  activity_date      DateTime       @db.Date
  activity           String         @db.VarChar(255)
  institution_group  String?        @db.VarChar(255)
  address            String?        @db.VarChar(255)
  focus              String?        @db.VarChar(255)
  location           String?        @db.VarChar(255)
  description_result String?        @db.Text
  pic_id             BigInt
  category_id        BigInt
  sub_category_id    BigInt
  is_deleted         Boolean        @default(false)
  is_archived        Boolean        @default(false)
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt
  cost               Decimal?       @db.Decimal(15, 2)
  document_link      String?        @db.Text
  category           categories     @relation(fields: [category_id], references: [id])
  pic                pics           @relation(fields: [pic_id], references: [id])
  sub_category       sub_categories @relation(fields: [sub_category_id], references: [id])

  @@index([activity_date])
  @@index([is_deleted])
  @@index([is_archived])
  @@index([category_id], map: "daily_activities_category_id_fkey")
  @@index([pic_id], map: "daily_activities_pic_id_fkey")
  @@index([sub_category_id], map: "daily_activities_sub_category_id_fkey")
}

model stakeholder_engagement {
  id            BigInt   @id @default(autoincrement())
  stakeholder   String   @db.VarChar(255)
  date          DateTime? @db.Date
  venue         String?   @db.VarChar(255)
  concern_issue String?  @db.Text
  document_link String?  @db.Text
  is_deleted    Boolean  @default(false)
  is_archived   Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([is_deleted])
  @@index([is_archived])
}

model top_issues {
  id                  BigInt   @id @default(autoincrement())
  period              String   @db.VarChar(50)
  year                Int      @default(2026)
  issue               String   @db.VarChar(255)
  description         String?  @db.Text
  follow_up           String?  @db.Text
  next_plan           String?  @db.Text
  is_deleted          Boolean  @default(false)
  is_archived         Boolean  @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  main_document       String?  @db.Text
  supporting_document String?  @db.Text

  @@index([is_deleted])
  @@index([is_archived])
  @@index([year])
}

model proposals {
  id                   BigInt   @id @default(autoincrement())
  registration_no      String   @unique @db.VarChar(50)
  date_received        DateTime @db.Date
  institution          String   @db.VarChar(255)
  address              String?  @db.VarChar(255)
  proposal_description String?  @db.Text
  proposal_file        String?  @db.Text
  assessment_file      String?  @db.Text
  status               String   @default("Under Review") @db.VarChar(20)
  is_deleted           Boolean  @default(false)
  is_archived          Boolean  @default(false)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@index([status])
  @@index([is_deleted])
  @@index([is_archived])
}

model csr_projects {
  id                    BigInt   @id @default(autoincrement())
  project_year          Int      @db.Year
  program               String   @db.VarChar(255)
  activity              String?  @db.VarChar(255)
  type_of_activity      String?  @db.VarChar(100)
  location              String?  @db.VarChar(255)
  target_beneficiaries  String?  @db.VarChar(255)
  objective             String?  @db.Text
  status                String   @default("Planning") @db.VarChar(20)
  budget                Decimal? @db.Decimal(15, 2)
  implementation_period String?  @db.VarChar(100)
  documentation_image   String?  @db.Text
  document              String?  @db.Text
  is_deleted            Boolean  @default(false)
  is_archived           Boolean  @default(false)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@index([project_year])
  @@index([status])
  @@index([is_deleted])
  @@index([is_archived])
}

model grievance {
  id               BigInt    @id @default(autoincrement())
  register_no      String    @unique @db.VarChar(50)
  log_date         DateTime  @db.Date
  complainant_name String    @db.VarChar(255)
  address          String?   @db.VarChar(255)
  phone            String?   @db.VarChar(30)
  category         String?   @db.VarChar(100)
  significance     String    @db.VarChar(20)
  description      String?   @db.Text
  location         String?   @db.VarChar(255)
  investigation    String?   @db.Text
  resolution       String?   @db.Text
  feedback         String?   @db.Text
  status           String    @default("Open") @db.VarChar(20)
  completion_date  DateTime? @db.Date
  remarks          String?   @db.Text
  supporting_files String?   @db.Text
  is_deleted       Boolean   @default(false)
  is_archived      Boolean   @default(false)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@index([status])
  @@index([significance])
  @@index([is_deleted])
  @@index([is_archived])
}

model lrp {
  id              BigInt   @id @default(autoincrement())
  program         String   @db.VarChar(255)
  year            Int      @default(2026)
  sharepoint_link String   @db.Text
  is_deleted      Boolean  @default(false)
  is_archived     Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([is_deleted])
  @@index([is_archived])
  @@index([year])
}

model sync_log {
  id            BigInt   @id @default(autoincrement())
  synced_at     DateTime @db.Timestamp(0)
  synced_year   Int?
  status        String   @db.VarChar(20)
  error_message String?  @db.Text
  file_url      String?  @db.VarChar(500)
  triggered_by  String?  @db.VarChar(100)
}
