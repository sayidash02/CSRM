{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e .env.test -o -- jest --runInBand",
    "test:unit": "dotenv -e .env.test -o -- jest --runInBand --config jest.unit.config.js",
    "test:integration": "dotenv -e .env.test -o -- prisma migrate deploy && dotenv -e .env.test -o -- tsx prisma/seed.ts && dotenv -e .env.test -o -- jest --runInBand --config jest.integration.config.js",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "seed": "tsx prisma/seed.ts",
    "db:test-migration": "dotenv -e .env.test -o -- tsx scripts/p0-migration-on-empty.ts",
    "db:backup-restore-smoke": "dotenv -e .env.test -o -- tsx scripts/p0-backup-restore-smoke.ts",
    "db:snapshot": "dotenv -e .env -- tsx ../../scripts/db/snapshot-ddl.ts",
    "db:check-integrity": "dotenv -e .env -- tsx ../../scripts/db/check-integrity.ts",
    "db:backup": "dotenv -e .env -- tsx ../../scripts/db/backup.ts",
    "db:clone": "dotenv -e .env -- tsx ../../scripts/db/clone-database.ts",
    "db:restore-drill": "dotenv -e .env -- tsx ../../scripts/db/restore-drill.ts",
    "db:drop-disposable": "dotenv -e .env -- tsx ../../scripts/db/drop-disposable-database.ts",
    "account:setup-admin": "dotenv -e .env -- ts-node --transpile-only scripts/setup-admin.ts",
    "account:recover-admin": "dotenv -e .env -- ts-node --transpile-only scripts/recover-admin.ts",
    "template:sanitize": "ts-node --transpile-only scripts/create-sanitized-template.ts",
    "test:mom-golden": "node -r ts-node/register/transpile-only scripts/mom-golden-visual.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "5.22.0",
    "cors": "^2.8.6",
    "docx": "9.6.1",
    "dotenv": "^17.4.2",
    "exceljs": "4.4.0",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prisma": "5.22.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
