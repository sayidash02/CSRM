# Database connection. The first admin is created separately with the
# interactive server command: pnpm --dir apps/api account:setup-admin
DATABASE_URL=mysql://crms_user:replace-with-password@127.0.0.1:3306/crms

# Comma-separated browser origins allowed to call the API with the session cookie.
CRMS_ALLOWED_ORIGINS=http://localhost:5173

# Optional operational settings.
PORT=3000
CRMS_LOG_LEVEL=info
CRMS_HEALTH_TIMEOUT_MS=1500

# Optional: session lifetime in minutes (15-1440). Defaults to 480 (8 hours).
CRMS_AUTH_SESSION_TTL_MINUTES=480

# Required only when intentionally running the destructive development reset locally.
CRMS_ENABLE_DEV_RESET=false
